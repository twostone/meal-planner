{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>twostone/hassio-workflows"
  ],
  "packageRules": [
    {
      "description": "Python-Abhängigkeiten der HA-Integration (uv.lock) in einem PR",
      "matchManagers": [
        "pep621"
      ],
      "groupName": "Python-Abhängigkeiten"
    },
    {
      "description": "svelte-check unterstützt TypeScript 7 noch nicht (siehe AGENTS.md)",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ]
}
