{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "essensplanung-dishes"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "exported_at": {
      "type": "string",
      "maxLength": 40
    },
    "dishes": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "const": ""
              },
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "const": ""
              },
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            }
          },
          "source_text": {
            "anyOf": [
              {
                "type": "string",
                "const": ""
              },
              {
                "type": "string",
                "maxLength": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "source_truncated": {
            "type": "boolean"
          },
          "recipe": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "servings": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "instructions": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": ""
                      },
                      {
                        "type": "string",
                        "maxLength": 10000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "ingredients": {
                    "maxItems": 60,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "section": {
                          "anyOf": [
                            {
                              "type": "string",
                              "const": ""
                            },
                            {
                              "type": "string",
                              "maxLength": 80
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "amount": {
                          "anyOf": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 100000
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "amount_max": {
                          "anyOf": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 100000
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "unit": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "g",
                                "kg",
                                "ml",
                                "l",
                                "EL",
                                "TL",
                                "Prise",
                                "Zehe",
                                "Bund",
                                "Dose",
                                "Packung",
                                "Becher",
                                "Scheibe",
                                "Handvoll"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "plural": {
                          "anyOf": [
                            {
                              "type": "string",
                              "const": ""
                            },
                            {
                              "type": "string",
                              "maxLength": 80
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "note": {
                          "anyOf": [
                            {
                              "type": "string",
                              "const": ""
                            },
                            {
                              "type": "string",
                              "maxLength": 200
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "prep": {
                          "anyOf": [
                            {
                              "type": "string",
                              "const": ""
                            },
                            {
                              "type": "string",
                              "maxLength": 200
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "raw": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 200
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "section",
                        "amount",
                        "amount_max",
                        "unit",
                        "name",
                        "note"
                      ]
                    }
                  }
                },
                "required": [
                  "servings",
                  "instructions",
                  "ingredients"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title"
        ]
      }
    }
  },
  "required": [
    "format",
    "version",
    "dishes"
  ],
  "title": "Essensplanung: geteilte Gerichte",
  "description": "Datei zum Austausch von Gerichten zwischen zwei Installationen der App Essensplanung."
}
